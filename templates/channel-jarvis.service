[Unit]
Description=Jarvis -- dashi-plugin channel (Telegram -> Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
# claude needs a TTY, so it lives in a detached tmux session (dedicated socket).
Type=forking
User={{USER}}
Group={{USER}}
WorkingDirectory={{PLUGIN_DIR}}
EnvironmentFile={{ENV_FILE}}
Environment=HOME={{HOME}}
Environment=PATH={{HOME}}/.bun/bin:{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/tmux -L channel-jarvis new-session -d -s channel-jarvis claude --model opus --dangerously-skip-permissions --dangerously-load-development-channels server:dashi-channel
# Walks the start-up prompts (imports, dev-channel warning, bypass mode).
ExecStartPost=/bin/bash {{CONFIRM_SCRIPT}} channel-jarvis
TimeoutStartSec=120
ExecStop=/usr/bin/tmux -L channel-jarvis kill-server
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
